{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/user-api(.*)",
      "target": "$1",
      "service": "sap-approuter-userapi",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/api/v1/(.*)$",
      "target": "/api/v1/$1",
      "destination": "srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/api/v2/(.*)$",
      "target": "/api/v2/$1",
      "destination": "srv-api",
      "csrfProtection": false,
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "dist"
    }
  ],
  "logout": {
    "logoutEndpoint": "/logout"
  },
  "websockets": {
    "enabled": true
  },
  "errorPage": [
    {"status": [404], "file": "dist/index.html"},
    {"status": [502, 503, 504], "file": "dist/gateway-error.json"}
  ]
}
